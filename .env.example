# ============ MySQL ============
MYSQL_ROOT_PASSWORD=请替换为高强度随机密码
MYSQL_USER=nexus_chat
MYSQL_PASSWORD=请替换为高强度随机密码

# ============ JWT ============
# 生成方法: openssl rand -base64 64
JWT_SECRET=请替换为64位随机密钥

# ============ CORS (允许App访问) ============
CORS_ORIGINS=http://localhost:8080

# ============ 邮件 (QQ邮箱) ============
MAIL_USERNAME=请替换为QQ邮箱
MAIL_PASSWORD=请替换为QQ邮箱授权码

# ============ Companion ============
# 生成方法: openssl rand -hex 32
COMPANION_API_KEY_SECRET=请替换为高强度随机密钥

# ============ Agent 内部通道 (Java <-> Python) ============
# 生成方法: openssl rand -hex 32
# 签名密钥：Java 调用 Python 的 HMAC 签名，两端必须一致
AGENT_INTERNAL_SIGNING_SECRET=请替换为高强度随机密钥
# 回调令牌：Python 工具调用 Java /internal/agent 的 Bearer token，两端必须一致
AGENT_INTERNAL_TOKEN=请替换为高强度随机密钥

# ============ Embedding (可选，Python Agent 使用) ============
# 预设: openai / dashscope / zhipu / siliconflow / ollama / newapi，留空则用显式配置
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
